# === LLM Configuration ===
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL_NAME=local-model
# Max output tokens per agent response (hemat VRAM & improve KV cache hit rate)
LLM_MAX_TOKENS=2000
# Set "none" untuk disable thinking mode di reasoning models (Qwen/DeepSeek)
# Menghemat ~20-50% token karena thinking output di-strip anyway
LLM_REASONING_EFFORT=none

# === OpenRouter alternative ===
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your_openrouter_key
# LLM_MODEL_NAME=anthropic/claude-sonnet-4.5

# === Xiaomi MiMo API alternative ===
# LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# LLM_API_KEY=your_mimo_api_key_here
# LLM_MODEL_NAME=mimo-v2.5-pro
# Dapatkan API key di: https://platform.xiaomimimo.com

# === DeepSeek API alternative ===
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your_deepseek_key
# LLM_MODEL_NAME=deepseek-v4-flash
# Model lain: deepseek-v4-pro
# Context caching DeepSeek aktif default dan usage memuat prompt_cache_hit_tokens / prompt_cache_miss_tokens.

# === API Keys (opsional) ===
# PASAL_ID_API_KEY=your_key_here

# === ChromaDB ===
CHROMA_DB_PATH=./rag/chroma_db
CHROMA_COLLECTION_NAME=mk_knowledge_base
# Manifest versi RAG data. Pada installer biasanya diarahkan ke %ProgramData%\SimuJR\rag\rag_data_manifest.json
RAG_DATA_MANIFEST_PATH=./rag/rag_data_manifest.json
# Root data runtime. Kosongkan saat development agar memakai ./results.
# SIMUJR_DATA_ROOT=C:\ProgramData\SimuJR
PASAL_API_TOKEN=your_pasal_id_token_here

# === Server Security ===
# Set API key untuk proteksi endpoint (kosongkan untuk disable)
API_KEY=
# CORS origins yang diizinkan (comma-separated, kosongkan untuk allow all)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Maksimal simulasi paralel
MAX_PARALLEL_SIMULATIONS=4
# Server host & port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
